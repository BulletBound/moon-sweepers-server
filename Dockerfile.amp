# syntax=docker/dockerfile:1

FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852 AS native-build
ARG MINHOOK_COMMIT=c3fcafdc10146beb5919319d0683e44e3c30d537
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates curl gcc-mingw-w64-x86-64 binutils-mingw-w64-x86-64 tar \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /native && curl --fail --location --retry 3 \
    "https://github.com/TsudaKageyu/minhook/archive/${MINHOOK_COMMIT}.tar.gz" \
    | tar -xz --strip-components=1 -C /native
COPY native/*.c native/*.h native/*.S native/*.def /native/host/
RUN mkdir -p /out && cd /native && x86_64-w64-mingw32-gcc -shared -O2 -Wall -Wextra -Werror \
    -Iinclude -Isrc -Ihost host/*.c host/version_proxy.S host/version.def \
    src/buffer.c src/hook.c src/trampoline.c src/hde/hde64.c \
    -static-libgcc -lshell32 -luser32 -lgdi32 -Wl,--no-insert-timestamp -o /out/version.dll \
    && cp LICENSE.txt /out/MinHook-LICENSE.txt

FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852 AS tools-build
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates curl gcc-mingw-w64-x86-64 \
    && rm -rf /var/lib/apt/lists/*
COPY container/server/steam-probe.c /src/steam-probe.c
RUN mkdir -p /out && x86_64-w64-mingw32-gcc -O2 -Wall -Wextra -Werror \
    -Wno-cast-function-type -static-libgcc /src/steam-probe.c -o /out/steam-probe.exe

FROM cubecoders/ampbase:wine-stable AS server
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates curl python3 tini procps tar gzip \
    lib32gcc-s1 lib32stdc++6 lib32z1 xvfb xauth x11-utils \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /usr/lib/wine && if [ ! -x /usr/lib/wine/wine64 ]; then p="$(command -v wine64 || command -v wine)"; test -n "$p"; ln -sf "$p" /usr/lib/wine/wine64; fi
RUN ln -s /AMP/moonsweepers/5335510 /data
RUN ln -s /data/import /import
RUN mkdir -p /opt/moon/bin /opt/moon/mod
COPY --from=tools-build /out/steam-probe.exe /opt/moon/bin/steam-probe.exe
COPY --chmod=755 container/server/entrypoint container/server/steam-redist container/server/server-import /opt/moon/bin/
RUN sed -i 's#mkdir -p /data/logs /data/probe /data/control /data/backups#mkdir -p /AMP/moonsweepers/5335510 /data/logs /data/probe /data/control /data/backups /data/import/game#' /opt/moon/bin/entrypoint
COPY container/server/health.py /opt/moon/bin/health.py
COPY container/server/redist-lock.json /opt/moon/bin/redist-lock.json
COPY --from=native-build /out/version.dll /opt/moon/mod/version.dll
COPY --from=native-build /out/MinHook-LICENSE.txt /opt/moon/mod/MinHook-LICENSE.txt
ENV WINEARCH=win64 WINEPREFIX=/data/wineprefix WINEDEBUG=-all \
    DISPLAY=:99 SteamAppId=5335510 SteamGameId=5335510 \
    MOON_HOST=1 MOON_DEDICATED=1 MOON_HEADLESS=1 \
    WINEDLLOVERRIDES="mscoree,mshtml=;version=n,b"
ENTRYPOINT ["/ampstart.sh"]
CMD []
